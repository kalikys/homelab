# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
tfplan
.terraform.tfstate.lock.info

# Secrets: only *.example files are committed
*.tfvars
*.tfvars.json
!*.tfvars.example
.env
.env.*
!.env.example
secrets*
*.pem
*.key

# OS / editors
.DS_Store
.idea/
.vscode/

# CV PDF has personal contacts: it lives only on the server
services/public/site/*.pdf

# Contact-click log written by nginx on the server
services/public/logs/

# Generated recruiting CVs contain contact information; deploy as private build assets.
services/public/site/cv/

# CV build artifacts (regenerated by deploy.sh)
services/public/cvgen/out/
services/public/cvgen/__pycache__/
