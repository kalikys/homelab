# /etc/systemd/system/ci-nat.service on the Proxmox host. See host/ci-nat.sh.
[Unit]
Description=NAT + LAN isolation for the CI bridge vmbr9
After=network-online.target pve-firewall.service
Wants=network-online.target

[Service]
Type=oneshot
# Optional: CI_EXTRA_DROP="<public IP>/32 ..." (IPv4 CIDRs, validated; see host/ci-nat.sh)
# On failure vmbr9 is taken down and this unit is failed: check `systemctl is-failed ci-nat` after boot.
EnvironmentFile=-/etc/default/ci-nat
ExecStart=/usr/local/sbin/ci-nat.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
