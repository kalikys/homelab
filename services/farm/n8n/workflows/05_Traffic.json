  {
   "id": "b8947a5d-eed1-57bd-85e4-44217e548ab3",
   "name": "Save campaign, open gate",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    1920,
    -280
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "WITH u AS (UPDATE experiments SET campaign = $2::jsonb, landing_url = $3, status = 'waiting_owner', updated_at = now() WHERE id = $1 AND status = 'running' RETURNING id),\ng AS (INSERT INTO gate_tokens (exp_id, gate, stage, choices) SELECT id, 'G-launch', 5, ARRAY['launched']::text[] FROM u RETURNING token),\nev AS (INSERT INTO events (exp_id, stage, kind, actor, message) SELECT id, 5, 'waiting_owner', 'n8n', 'Ждёт решения владельца: G-launch' FROM u RETURNING 1)\nSELECT (SELECT token FROM g) AS token",
    "options": {
     "queryReplacement": "={{ [$('Load context').first().json.exp_id, JSON.stringify($json.campaign), $('Publish live').first().json.url] }}"
    }
   },
   "credentials": {
    "postgres": {
     "id": "AQDTH0A6lV9UWRdi",
     "name": "Farm DB (farm)"
    }
   }
  },
  {
   "id": "06a9d2f3-9275-5de2-9507-679dc936f1a4",
   "name": "Compose launch steps",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2160,
    -280
   ],
   "parameters": {
    "jsCode": "const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst x = $('Load context').first().json, cmp = $('Validate campaign').first().json.campaign || {};\nconst t = $('Save campaign, open gate').first().json.token;\nconst steps = (cmp.owner_steps || []).map(s => esc(s)).join('\\n');\nconst ads = (cmp.ads || []).slice(0, 1).map(a => '«' + esc((a.headlines || []).slice(0, 3).join(' | ')) + '»').join('');\nreturn [{ json: { text: `🚀 <b>${esc(x.exp_id)}: кампания готова</b> · ${esc(cmp.channel)} · бюджет $${cmp.budget_usd}, не больше $${cmp.daily_cap_usd}/день\\n` +\n  `Лендинг: ${esc($('Publish live').first().json.url)}\\n${ads ? 'Объявление: ' + ads + '\\n' : ''}\\n<b>Как запустить:</b>\\n${steps}\\n\\n` +\n  `Полная спецификация (ключи, тексты, ссылки) — в n8n и в /work/${esc(x.exp_id)}/test/campaign.json.\\n` +\n  `<a href=\"https://n8n.home.kalik8s.ru/webhook/farm-gate?g=${t}&c=launched\">Я запустил кампанию</a> — с этого момента считаем тест. Траты отмечай в пульте: action=cost&source=ads.` } }];"
   }
  },
