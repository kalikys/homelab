   "parameters": {
    "jsCode": "const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst x = $('Load context').first().json, pub = $('Publish preview').first().json;\nconst t = $('Save, open gate').first().json.token;\nreturn [{ json: { text: `🖥 <b>${esc(x.exp_id)}: лендинг готов</b> — проверка кодом пройдена.\\n${esc(x.title)}\\n\\n` +\n  `<a href=\"${pub.preview_url}\">Открыть превью</a> (видно только по этой ссылке, визиты не считаются)\\n\\n` +\n  `<a href=\"https://n8n.home.kalik8s.ru/webhook/farm-gate?g=${t}&c=approve\">Опубликовать</a> — после этого агент готовит кампанию. Не нравится — напиши, что поменять.` } }];"
   }
  },
