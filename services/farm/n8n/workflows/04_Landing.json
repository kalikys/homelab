    "operation": "executeQuery",
    "query": "WITH u AS (UPDATE experiments SET landing_url = $2, status = 'waiting_owner', updated_at = now() WHERE id = $1 AND status = 'running' RETURNING id),\ng AS (INSERT INTO gate_tokens (exp_id, gate, stage, choices) SELECT id, 'G-publish', 4, ARRAY['approve']::text[] FROM u RETURNING token),\nev AS (INSERT INTO events (exp_id, stage, kind, actor, message) SELECT id, 4, 'waiting_owner', 'n8n', 'Ждёт решения владельца: G-publish' FROM u RETURNING 1)\nSELECT (SELECT token FROM g) AS token",
