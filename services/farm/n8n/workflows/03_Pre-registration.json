  {
   "id": "f502cff5-2629-5a6d-b320-6e9bf4e90df3",
   "name": "Save plan, open gate",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    1920,
    -280
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "WITH u AS (UPDATE experiments SET prereg = $2::jsonb, prereg_hash = $3, status = 'waiting_owner', updated_at = now() WHERE id = $1 AND status = 'running' RETURNING id),\ng AS (INSERT INTO gate_tokens (exp_id, gate, stage, choices) SELECT id, 'G-prereg', 3, ARRAY['approve']::text[] FROM u RETURNING token),\nev AS (INSERT INTO events (exp_id, stage, kind, actor, message) SELECT id, 3, 'waiting_owner', 'n8n', 'Ждёт решения владельца: G-prereg' FROM u RETURNING 1)\nSELECT (SELECT token FROM g) AS token",
    "options": {
     "queryReplacement": "={{ [$('Load context').first().json.exp_id, JSON.stringify($json.prereg), $json.hash] }}"
    }
