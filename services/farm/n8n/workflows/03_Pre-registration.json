  {
   "id": "fe68ce39-1f2a-531f-bbfe-02782c869d07",
   "name": "Compose approval",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2880,
    -280
   ],
   "parameters": {
    "jsCode": "const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst x = $('Load context').first().json, p = $('Validate pre-registration').first().json.prereg || {};\nconst t = $('Save plan, open gate').first().json.token;\nconst pct = v => (Number(v) * 100).toFixed(1) + '%';\nconst th = p.thresholds || {};\nreturn [{ json: { text: `📋 <b>${esc(x.exp_id)}: условия смоук-теста</b> (PDF выше)\\n${esc(x.title)}\\n\\n` +\n  `Бюджет $${p.budget_usd} (≤ $${p.daily_cap_usd}/день) · ${p.duration_days} дн. · цель ${p.target_visitors} посетителей · канал ${esc(p.channel)}\\n` +\n  `GO: заявки ≥ ${pct((th.go || {}).signup_rate)} · KILL: ≤ ${pct((th.kill || {}).signup_rate)}\\n\\n` +\n  `<a href=\"https://n8n.home.kalik8s.ru/webhook/farm-gate?g=${t}&c=approve\">Утверждаю условия</a> — одноразовая ссылка, 72 ч. Не согласен — просто не нажимай и напиши, что поменять.` } }];"
   }
  },
