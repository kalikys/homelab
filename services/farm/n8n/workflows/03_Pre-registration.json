  {
   "id": "8a4d580a-4adc-5a63-a16e-f4486292cb86",
   "name": "Load context",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    720,
    -120
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "SELECT e.id AS exp_id, e.chosen_brief AS slug, e.prereg, e.landing_url, e.title,\n  (SELECT value FROM settings WHERE key = 'budget_test_usd')::numeric AS budget_cap, (SELECT json_build_object(\n  'lessons', (SELECT coalesce(json_agg(json_build_object('id', l.id, 'kind', l.kind, 'lesson', l.lesson, 'weight', l.weight)), '[]'::json)\n              FROM (SELECT * FROM lessons WHERE active AND track = x.track ORDER BY weight DESC, last_seen DESC LIMIT 10) l),\n  'history', (SELECT coalesce(json_agg(json_build_object('slug', h.slug, 'title', h.title, 'outcome', h.outcome, 'score', h.score,\n                                                          'verdict', h.verdict, 'why', h.reasons) ORDER BY h.ts DESC), '[]'::json)\n              FROM (SELECT DISTINCT ON (slug) * FROM idea_history WHERE track = x.track ORDER BY slug, ts DESC LIMIT 200) h))\n FROM (SELECT track FROM experiments WHERE id = $1) x) AS memory, ((SELECT coalesce(max(value) FILTER (WHERE key = 'api_budget_month_usd'), '0')::numeric FROM settings)\n  - (SELECT coalesce(sum(usd), 0) FROM costs WHERE source = 'claude_api' AND ts >= date_trunc('month', now())) > 5) AS use_api\nFROM experiments e WHERE e.id = $1",
    "options": {
     "queryReplacement": "={{ [$('Expect this stage').first().json.exp_id] }}"
    }
   },
   "credentials": {
    "postgres": {
     "id": "AQDTH0A6lV9UWRdi",
     "name": "Farm DB (farm)"
    }
   }
  },
