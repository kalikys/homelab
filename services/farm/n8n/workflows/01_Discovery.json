  {
   "id": "9dbcbac5-970f-582c-9716-c0f46f976f3a",
   "name": "Summarise",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1440,
    -180
   ],
   "parameters": {
    "jsCode": "const run = $('Agent: discovery').first().json;\nconst val = $input.first().json;\nconst exp = $('Expect this stage').first().json.exp_id;\nconst briefs = val.briefs || [];\nconst passed = briefs.filter(b => b.passed);\nreturn [{ json: { exp_id: exp, passed: passed.length, total: briefs.length, cost: run.cost_usd || 0, turns: run.turns, session: run.session_id,\n  billing: run.billing,\n  briefs: briefs.map(b => ({ slug: b.slug, title: b.title, channel: b.channel, cpc: b.cpc, price: b.price, passed: b.passed, failures: b.failures })) } }];"
   }
  },
  {
   "id": "c8c46afc-1ff4-58a7-81ec-2ee93a45bbc6",
   "name": "Record cost, candidates, stage",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    1680,
    -180
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "WITH j AS (SELECT $1::jsonb AS j),\nc AS (INSERT INTO costs (exp_id, source, usd, detail)\n      SELECT j->>'exp_id', CASE WHEN j->>'billing' = 'api' THEN 'claude_api' ELSE 'claude_subscription_equiv' END, coalesce((j->>'cost')::numeric, 0), 'discovery session ' || coalesce(j->>'session','') FROM j RETURNING 1),\nh AS (INSERT INTO idea_history (exp_id, track, round, slug, title, outcome, reasons)\n      SELECT e.id, e.track, e.round, b->>'slug', b->>'title', 'rejected_by_checks', jsonb_build_object('failed_checks', b->'failures')\n      FROM j, experiments e, jsonb_array_elements(j->'briefs') b\n      WHERE e.id = j->>'exp_id' AND NOT coalesce((b->>'passed')::boolean, false) RETURNING 1),\nu AS (UPDATE experiments SET stage  = CASE WHEN (SELECT (j->>'passed')::int FROM j) > 0 THEN 2 ELSE stage END,\n                             status = CASE WHEN (SELECT (j->>'passed')::int FROM j) > 0 THEN 'active' ELSE 'blocked' END,\n                             briefs = (SELECT j->'briefs' FROM j), updated_at = now()\n      WHERE id = (SELECT j->>'exp_id' FROM j) AND status = 'running' RETURNING id),\nev AS (INSERT INTO events (exp_id, stage, kind, actor, message)\n       SELECT j->>'exp_id', 1, CASE WHEN (j->>'passed')::int > 0 THEN 'candidates_ready' ELSE 'candidates_rejected' END, 'n8n',\n              'Discovery: прошли проверку ' || (j->>'passed') || ' из ' || (j->>'total') || ' брифов, ходов агента ' || coalesce(j->>'turns','?') FROM j RETURNING 1)\nSELECT (SELECT (j->>'passed')::int FROM j) AS passed",
    "options": {
     "queryReplacement": "={{ [JSON.stringify($json)] }}"
    }
   },
   "credentials": {
    "postgres": {
     "id": "AQDTH0A6lV9UWRdi",
     "name": "Farm DB (farm)"
    }
   }
  },
