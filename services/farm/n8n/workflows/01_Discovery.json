  {
   "id": "9dbcbac5-970f-582c-9716-c0f46f976f3a",
   "name": "Summarise",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1440,
    -180
   ],
   "parameters": {
    "jsCode": "const run = $('Agent: discovery').first().json;\nconst val = $input.first().json;\nconst exp = $('Expect this stage').first().json.exp_id;\nconst briefs = val.briefs || [];\nconst passed = briefs.filter(b => b.passed);\nreturn [{ json: { exp_id: exp, passed: passed.length, total: briefs.length, cost: run.cost_usd || 0, turns: run.turns, session: run.session_id,\n  choices: passed.map(b => b.slug),\n  briefs: briefs.map(b => ({ slug: b.slug, title: b.title, channel: b.channel, cpc: b.cpc, price: b.price, passed: b.passed, failures: b.failures })) } }];"
   }
  },
  {
   "id": "103f477a-b15d-54b0-911f-7992067a3ec5",
   "name": "Record cost, briefs, stage, gate",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    1680,
    -180
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "WITH j AS (SELECT $1::jsonb AS j),\nc AS (INSERT INTO costs (exp_id, source, usd, detail)\n      SELECT j->>'exp_id', 'claude_subscription_equiv', coalesce((j->>'cost')::numeric, 0), 'discovery session ' || coalesce(j->>'session','') FROM j RETURNING 1),\nu AS (UPDATE experiments SET stage  = CASE WHEN (SELECT (j->>'passed')::int FROM j) > 0 THEN 2 ELSE stage END,\n                             status = CASE WHEN (SELECT (j->>'passed')::int FROM j) > 0 THEN 'active' ELSE 'blocked' END,\n                             briefs = (SELECT j->'briefs' FROM j),\n                             updated_at = now()\n      WHERE id = (SELECT j->>'exp_id' FROM j) RETURNING id),\nev AS (INSERT INTO events (exp_id, stage, kind, actor, message)\n       SELECT j->>'exp_id', 1, CASE WHEN (j->>'passed')::int > 0 THEN 'briefs_ready' ELSE 'briefs_rejected' END, 'n8n',\n              'Discovery: прошли проверку ' || (j->>'passed') || ' из ' || (j->>'total') || ' брифов, ходов агента ' || coalesce(j->>'turns','?') FROM j RETURNING 1)\nSELECT (SELECT (j->>'passed')::int FROM j) AS passed",
    "options": {
     "queryReplacement": "={{ [JSON.stringify($json)] }}"
    }
   },
   "credentials": {
    "postgres": {
     "id": "AQDTH0A6lV9UWRdi",
     "name": "Farm DB (farm)"
    }
   }
  },
  {
   "id": "03b1df6a-36f2-51cc-b34e-f7f80d413cfc",
   "name": "Compose message",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1920,
    -180
   ],
   "parameters": {
    "jsCode": "const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst s = $('Summarise').first().json;\nconst passed = s.briefs.filter(b => b.passed);\nconst failed = s.briefs.filter(b => !b.passed);\nlet text;\nif (passed.length) {\n  text = `🧭 <b>${s.exp_id}: найдено ${passed.length} кандидатов</b> (проверку прошли ${passed.length} из ${s.total}).\nДальше аналитики делают due diligence по каждому и пришлют PDF-меморандумы:\n\n` +\n    passed.slice(0, 3).map((b, i) => `${i+1}. ${esc(b.title)}`).join('\n');\n} else {\n  text = `⛔ <b>${s.exp_id}: ни один бриф не прошёл проверку</b> (${failed.length}). Этап заблокирован до разбора.\n` +\n    failed.slice(0, 3).map(b => `• ${esc(b.title || b.slug)}: ${esc((b.failures || []).join('; '))}`).join('\n');\n}\nreturn [{ json: { text, passed: passed.length } }];"
   }
  },
