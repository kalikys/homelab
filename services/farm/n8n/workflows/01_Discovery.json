  {
   "id": "1017d2e9-149a-5b66-a8ed-40197f74bb27",
   "name": "Validate briefs (code, no LLM)",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1200,
    -180
   ],
   "parameters": {
    "method": "POST",
    "url": "=http://172.30.0.10:8080/validate/discovery/{{ $('Expect this stage').first().json.exp_id }}",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "options": {
     "timeout": 600000
    }
   },
   "credentials": {
    "httpHeaderAuth": {
