  {
   "id": "f81621b4-4b05-5404-895b-67e458cfe11a",
   "name": "Blocked report",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    720,
    220
   ],
   "parameters": {
    "jsCode": "const r = $('Guardrail preflight').first().json;\nconst failed = (r.checks || []).filter(c => !c.passed).map(c => '✗ ' + c.detail).join('\\n');\nreturn [{ json: { exp_id: r.exp_id, stage: 2, kind: 'guardrail_blocked', actor: 'n8n', message: '⛔ Этап 02 · Due diligence остановлен guardrails. Не выполнены условия:\\n' + failed, notify: true } }];"
   }
  },
