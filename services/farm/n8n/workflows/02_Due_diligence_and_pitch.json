  {
   "id": "2f150b0a-91ba-5e03-a127-04dbff2c504c",
   "name": "Briefs to analyse",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    720,
    -120
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "SELECT e.id AS exp_id, b->>'slug' AS slug, b->>'title' AS title\nFROM experiments e, jsonb_array_elements(coalesce(e.briefs, '[]'::jsonb)) b\nWHERE e.id = $1 AND (b->>'passed')::boolean IS TRUE\nLIMIT 3",
    "options": {
     "queryReplacement": "={{ [$('Expect this stage').first().json.exp_id] }}"
    }
   },
