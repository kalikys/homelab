   "onError": "continueRegularOutput"
  },
  {
   "id": "2c3a52a7-ed13-5bf0-9adf-1d501e82485a",
   "name": "Collect results",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2160,
    -120
   ],
   "parameters": {
    "jsCode": "const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst items = $('Briefs to analyse').all().map(i => i.json);\nconst runs = $('Agent: diligence').all().map(i => i.json);\nconst vals = $('Validate memo (code, no LLM)').all().map(i => i.json);\nconst out = items.map((it, k) => {\n  const r = runs[k] || {}, v = vals[k] || {};\n  return { slug: it.slug, title: v.title || it.title, agent_ok: r.ok === true, cost: r.cost_usd || 0, turns: r.turns, session: r.session_id,\n           passed: v.passed === true, verdict: v.verdict || null, evidence: v.evidence_count, verified: v.verified_quotes,\n           failed_checks: (v.checks || []).filter(c => !c.passed).map(c => c.detail) };\n});\nconst exp = $('Expect this stage').first().json.exp_id;\nreturn [{ json: { exp_id: exp, memos: out, choices: out.filter(m => m.passed).map(m => m.slug), total_cost: out.reduce((a, m) => a + Number(m.cost || 0), 0) } }];"
   }
  },
  {
   "id": "212b8ac2-da01-5cfa-9103-9470ca56bd15",
   "name": "Record memos, cost, gate",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    2400,
    -120
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "WITH j AS (SELECT $1::jsonb AS j),\nc AS (INSERT INTO costs (exp_id, source, usd, detail)\n      SELECT j->>'exp_id', 'claude_subscription_equiv', coalesce((m->>'cost')::numeric, 0), 'diligence ' || (m->>'slug')\n      FROM j, jsonb_array_elements(j->'memos') m RETURNING 1),\nu AS (UPDATE experiments SET diligence = (SELECT j->'memos' FROM j),\n                             status = CASE WHEN jsonb_array_length((SELECT j->'choices' FROM j)) > 0 THEN 'waiting_owner' ELSE 'blocked' END,\n                             updated_at = now()\n      WHERE id = (SELECT j->>'exp_id' FROM j) AND status = 'running' RETURNING id),\ng AS (INSERT INTO gate_tokens (exp_id, gate, stage, choices)\n      SELECT j->>'exp_id', 'G1', 2, ARRAY(SELECT jsonb_array_elements_text(j->'choices')) FROM j WHERE jsonb_array_length(j->'choices') > 0\n      RETURNING token),\nev AS (INSERT INTO events (exp_id, stage, kind, actor, message)\n       SELECT j->>'exp_id', 2, 'memos_ready', 'n8n', 'Due diligence: меморандумов прошло проверку ' || jsonb_array_length(j->'choices') || ' из ' || jsonb_array_length(j->'memos') FROM j RETURNING 1)\nSELECT (SELECT token FROM g) AS token",
    "options": {
     "queryReplacement": "={{ [JSON.stringify($json)] }}"
    }
   },
   "credentials": {
    "postgres": {
     "id": "AQDTH0A6lV9UWRdi",
     "name": "Farm DB (farm)"
    }
   }
  },
  {
   "id": "69c5529c-98ad-5bd2-83a0-f0668b643e90",
   "name": "Compose summary",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2640,
    -120
   ],
   "parameters": {
    "jsCode": "const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst s = $('Collect results').first().json;\nconst token = $input.first().json.token;\nconst rec = { invest: '🟢 инвестировать', maybe: '🟡 под вопросом', pass: '🔴 не инвестировать' };\nconst lines = s.memos.map((m, i) => {\n  const v = m.verdict || {};\n  const head = `${i+1}. <b>${esc(m.title)}</b>\\n   ${rec[v.recommendation] || '—'} · ${v.score_0_10 ?? '—'}/10 · доказательств ${m.evidence ?? '—'}, подтверждено цитат ${m.verified ?? '—'}`;\n  if (m.passed && token) return head + `\\n   <a href=\"https://n8n.home.kalik8s.ru/webhook/farm-gate?g=${token}&c=${encodeURIComponent(m.slug)}\">Выбрать для теста</a>`;\n  return head + `\\n   ✗ не прошёл проверку: ${esc((m.failed_checks || []).slice(0, 2).join('; ') || (m.agent_ok ? '' : 'агент не справился'))}`;\n});\nconst text = `📊 <b>${s.exp_id}: инвестиционные меморандумы готовы</b>\\nPDF — выше. Выбери одну идею для смоук-теста за $150 (ссылки одноразовые, 72 ч, дома или через Tailscale):\\n\\n` + lines.join('\\n\\n');\nreturn [{ json: { text } }];"
   }
  },
