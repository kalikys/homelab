   ],
   "parameters": {
    "operation": "sendDocument",
    "chatId": "260160459",
    "binaryData": true,
    "binaryPropertyName": "data",
    "additionalFields": {
     "caption": "={{ '📄 ' + $('Briefs to analyse').item.json.exp_id + ' · ' + ($('Validate memo (code, no LLM)').item.json.title || $('Briefs to analyse').item.json.title) + ($('Validate memo (code, no LLM)').item.json.passed ? '' : ' (не прошёл проверку)') }}",
     "fileName": "={{ $('Briefs to analyse').item.json.exp_id + '-' + $('Briefs to analyse').item.json.slug + '.pdf' }}"
    }
   },
   "credentials": {
    "telegramApi": {
     "id": "tURAovmMnZsndM8n",
     "name": "Telegram (Hermes bot, send only)"
    }
   },
   "retryOnFail": true,
