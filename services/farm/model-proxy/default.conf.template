# Model proxy for farm agents: agents reach Anthropic only through here and never hold a real credential.
# :8080 adds the subscription OAuth token, :8081 the prepaid API key; the placeholder the agent sends is replaced.
server {
    listen 8080;
    location / {
        proxy_pass https://api.anthropic.com;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host api.anthropic.com;
        proxy_set_header Authorization "Bearer ${CLAUDE_CODE_OAUTH_TOKEN}";
        proxy_set_header x-api-key "";
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 900s;
        client_max_body_size 64m;
    }
}
server {
    listen 8081;
    location / {
        proxy_pass https://api.anthropic.com;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host api.anthropic.com;
        proxy_set_header x-api-key "${ANTHROPIC_API_KEY}";
        proxy_set_header Authorization "";
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 900s;
        client_max_body_size 64m;
    }
}
